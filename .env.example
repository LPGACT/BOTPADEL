# ============================================================
#  BOT PADEL - ATC SPORTS  |  Archivo de configuración
#  Copiá este archivo como ".env" y completá los valores
# ============================================================

# --- CUENTA ATC SPORTS ---
ATC_EMAIL=tu_email@gmail.com

# --- GMAIL IMAP (para leer el magic link automáticamente) ---
# Generá una App Password SIN ESPACIOS en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcdefghijklmnop

# --- GMAIL SMTP (para enviar notificaciones) ---
SMTP_USER=tu_email@gmail.com
SMTP_PASS=abcdefghijklmnop
NOTIFY_EMAIL=tu_email@gmail.com

# --- TELEGRAM ---
# Token del bot (de @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# Tu Chat ID personal (de @userinfobot)
TELEGRAM_CHAT_ID=123456789
# Chat ID del grupo donde notificar la reserva (OPCIONAL - número negativo)
# Pasos: 1) Agregá el bot al grupo  2) Mandá un mensaje  3) Abrí en browser:
# https://api.telegram.org/bot<TOKEN>/getUpdates  4) Buscá "chat":{"id":XXXXX}
TELEGRAM_GROUP_ID=

# --- VENUE ATC SPORTS ---
VENUE_URL=https://atcsports.io/venues/kuman-caba
# VENUE_PLACE_ID: dejar vacío si no aparece en la URL del browser
VENUE_PLACE_ID=
SPORT_ID=17

# --- CONFIGURACIÓN DE RESERVA ---
DURATION_MINUTES=90
TARGET_TIMES=18:00,18:30,19:00,19:30

# --- COMPORTAMIENTO ---
CHECK_INTERVAL_MS=300000
STOP_AFTER_BOOKING=true
HEADLESS=true
